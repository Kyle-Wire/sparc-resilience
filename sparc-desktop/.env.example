# ─── Supabase (auth + license backend) ────────────────────────────────
# Required for normal users. Without these the app falls back to
# `no_license` unless creator mode is on.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ─── Creator / dev bypass ─────────────────────────────────────────────
# Set to "1" to mint a perpetual team-tier license at startup with no
# auth, no Supabase round-trip, no Lemon Squeezy. Intended for the
# project creator's own builds. Leave UNSET in distributed binaries.
#
# Alternatively, in any build, type a license key starting with
# "SPARC-CREATOR-" on the License Key tab of the login screen and it
# will be accepted locally without verification.
#VITE_SPARC_CREATOR_MODE=1
