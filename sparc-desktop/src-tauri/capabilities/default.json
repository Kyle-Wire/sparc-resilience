{
  "identifier": "default",
  "description": "Default capabilities for the SPARC desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-open",
      "allow": ["https://**", "http://**"]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/sparc-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
