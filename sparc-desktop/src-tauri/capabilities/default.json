{
  "identifier": "default",
  "description": "Default capabilities for the SPARC desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-relaunch",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/sparc-sidecar",
          "sidecar": true,
          "args": true
        },
        {
          "name": "python",
          "args": true
        }
      ]
    }
  ]
}
